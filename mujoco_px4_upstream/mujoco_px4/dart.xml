<mujoco model="dart">
	<compiler inertiafromgeom="false" coordinate="local"/>
	<option	timestep="0.005" gravity="0 0 -9.81" density="1" viscosity="1e-5" integrator="RK4" />

	<asset> 
		<mesh name="DART_mesh" file="dart2.stl" scale="0.001 0.001 0.001"/>
	</asset>

	<worldbody>
		<!-- <geom name="floor" pos="0 0 0" size="2 2 .2" type="plane"  conaffinity="1" rgba="1 1 1 1" condim="3"/> -->
		<body name="quadrotor" pos="-1.0 2.0 0.0125">
			<inertial pos="0.0 0.0 0.0" mass="1.25" diaginertia="0.0025 0.0025 0.0045" />	
			<!-- <geom name="core" type="box" pos="0 0 0" quat = "1. 0. 0. 0" size="0.06 0.035 0.025"  rgba="0.3 0.3 0.8 1" mass = "1.1"/> -->

			<geom type="mesh" mesh="DART_mesh" pos="-0.23 0.195 .015" quat=".6705 0.6705 -0.2244 -.2244 " solimp=".7 .7 .1" solref="0.1 1"/>
			<!-- <geom type="mesh" mesh="DART_mesh" pos="-1.0 2.0 .015" quat=".6705 0.6705 -0.2244 -.2244 " solimp=".7 .7 .1" solref="0.1 1"/> -->

			<!-- <geom name="a00" type="box" pos=".071 0.071 0.0" size="0.05 0.01 0.0025"  quat = ".924 0.0 0.0 0.383" rgba="0.3 0.3 0.8 1" mass = ".025"/> -->
			<!-- <geom name="a10" type="box" pos=".071 -0.071 0.0" size="0.05 0.01 0.0025"  quat = ".383 0.0 0.0 0.924" rgba="0.3 0.3 0.8 1" mass = ".025"/> -->
			<!-- <geom name="a20" type="box" pos="-0.071 -0.071 0.0" size="0.05 0.01 0.0025"  quat = "-.383 0.0 0.0 0.924" rgba="0.3 0.3 0.8 1" mass = ".025"/> -->
			<!-- <geom name="a30" type="box" pos="-.071 0.071 0.0" size="0.05 0.01 0.0025"  quat = ".924 0.0 0.0 -0.383" rgba="0.3 0.3 0.8 1" mass = ".025"/> -->

			<joint name="root"   type="free" damping="0" armature="0" pos="0.0 0.0 0.0" />

			<!-- Motor sites to attach motor actuators -->
            <site name="motor0" type="cylinder" pos="0.15 -0.15 0.01"  size="0.01 0.0025"  quat = "1.0 0.0 0.0 0." rgba="0.3 0.8 0.3 1"/>
            <site name="motor1" type="cylinder" pos="-0.15 0.15 0.01"  size="0.01 0.0025"  quat = "1.0 0.0 0.0 0." rgba="0.3 0.8 0.3 1"/>
            <site name="motor2" type="cylinder" pos="0.15 0.15 0.01"  size="0.01 0.0025"  quat = "1.0 0.0 0.0 0." rgba="0.3 0.8 0.3 1"/>
            <site name="motor3" type="cylinder" pos="-0.15 -0.15 0.01"  size="0.01 0.0025"  quat = "1.0 0.0 0.0 0." rgba="0.3 0.8 0.3 1"/>

			<!-- Thruster geometries for collisions since site's are excluded from collision checking -->
            <geom name="thruster0" type="cylinder" pos="0.15 -0.15 0.025" size="0.08 0.0025"  quat = "1.0 0.0 0.0 0." rgba="1 0.0 0.0 .3" mass = ".025"/>
            <geom name="thruster1" type="cylinder" pos="-0.15 0.15 0.025" size="0.08 0.0025"  quat = "1.0 0.0 0.0 0." rgba="1 0.0 0.0 .3" mass = ".025"/>
            <geom name="thruster2" type="cylinder" pos="0.15 0.15 0.025" size="0.08 0.0025"  quat = "1.0 0.0 0.0 0." rgba="1 0 0.0 .3" mass = ".025"/>
            <geom name="thruster3" type="cylinder" pos="-0.15 -0.15 0.025" size="0.08 0.0025"  quat = "1.0 0.0 0.0 0." rgba="1 0. 0.0 .3" mass = ".025"/>

            <!-- Visualization of the coordinate frame -->
			<site name="qcX" type="box" pos="0.1 0.0 0.0" size="0.1 0.005 0.005"  quat = " 1.000  0.0  0.0    0."     rgba="1 0 0 1" />
			<site name="qcY" type="box" pos="0.0 0.1 0.0" size="0.1 0.005 0.005"  quat = " 0.707  0.0  0.0    0.707"  rgba="0 1 0 1" />
			<site name="qcZ" type="box" pos="0.0 0.0 0.1" size="0.1 0.005 0.005"  quat = "-0.707  0.0  0.707  0."     rgba="0 0 1 1" />
			<camera name="quad_cam" pos="-1.5 0.0 1.5" xyaxes="0 -1 0 1 0 1" mode="track"/>
		</body>

		<body name="wall1" pos= "0.0 0.0 1.0">
			<inertial pos="0.0 0.0 0.0" mass="300.0" diaginertia="100.0 100.0 100.0" />
			<geom name="wall_geom1" friction="0.05 0.005 0.0001" type="box" pos=" 0.0 0.0 0.0" size=".001 3.5 1.0"  quat = "0.7071068 0.0 0.0 0.7071068" solimp=".95 .99 .001" solref="0.01 0.1" rgba="0.8 0.8 0.8 1.0" />
		</body>

		<body name="wall2" pos= "0.0 3.0 1.0">
			<inertial pos="0.0 0.0 0.0" mass="300.0" diaginertia="100.0 100.0 100.0" />
			<geom name="wall_geom2" friction="0.05 0.005 0.0001" type="box" pos=" 0.0 0.0 0.0" size=".001 3.5 1.0"  quat = "0.7071068 0.0 0.0 0.7071068" solimp=".99 .99 .001" solref="0.01 0.11" rgba="0.8 0.8 0.8 1.0" />
		</body>

        <body name="wall3" pos= "0.0 2.0 1.0">
            <inertial pos="0.0 0.0 0.0" mass="300.0" diaginertia="100.0 100.0 100.0" />
            <geom name="wall_geom3" type="box" pos=" 0.0 0.0 0.0" size=".1 1.0 1.0"  quat = "1.0 0.0 0.0 0.0" solimp=".7 .7 .1" solref="0.1 1" rgba="0.8 0.8 0.8 1.0" />
        </body>

        <body name="wall4" pos="2.5 1.0 1.0">
            <inertial pos="0.0 0.0 0.0" mass="300.0" diaginertia="100.0 100.0 100.0" />
            <geom name="wall_geom4" type="box" pos=" 0.0 0.0 0.0" size=".1 1.0 1.0"  quat = "1.0 0.0 0.0 0.0" solimp=".7 .7 .1" solref="0.1 1" rgba="0.8 0.8 0.8 1.0" />
        </body>

	</worldbody>
    <actuator>
        <motor ctrllimited="true" ctrlrange="0.0 7" gear="0  0. 1. 0. 0.  -0.016" site="motor0"/>
        <motor ctrllimited="true" ctrlrange="0.0 7" gear="0  0. 1. 0. 0.  -0.016" site="motor1"/>
        <motor ctrllimited="true" ctrlrange="0.0 7" gear="0  0. 1. 0. 0.  0.016" site="motor2"/>
        <motor ctrllimited="true" ctrlrange="0.0 7" gear="0  0. 1. 0. 0.  0.016" site="motor3"/>
	</actuator>
</mujoco>